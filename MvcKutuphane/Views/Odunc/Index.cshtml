@using MvcKutuphane.Models.Entity
@model List<TblHareket>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Layout.cshtml";
}
<div style="margin-top:15px"></div>
<h2>Ödünç Kitap Listesi</h2>

<table class="table table-bordered">
    <tr>
        <th>İşlem ID</th>
        <th>Kitap Adı</th>
        <th>Üye</th>
        <th>Personel</th>
        <th>Alış Tarihi</th>
        <th>İade Tarihi</th>
        <th>İade Al</th>

    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.id</td>
            <td>@item.TblKitap.ad</td>
            <td>@item.TblUyeler.ad&nbsp @item.TblUyeler.soyad</td>
            <td>@item.TblPersonel.personel</td>
            <td>@Convert.ToDateTime(item.alistarih).ToString("dd/MM/yyyy")</td>
            <td>@Convert.ToDateTime(item.iadetarih).ToString("dd/MM/yyyy")</td>
            <td><a href="/Odunc/OduncIade/@item.id" class="btn btn-outline-success">Kitabı İade Et</a></td>

        </tr>
    }

</table>


