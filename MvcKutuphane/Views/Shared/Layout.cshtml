
@{
    Layout = null;
}

<link href="~/Content/bootstrap.css" rel="stylesheet" />
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    @*<script src="https://kit.fontawesome.com/a7e5d217bc.js" crossorigin="anonymous"></script>*@   
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: "Lato", sans-serif;
        }

        .sidebar {
            height: 100%;
            width: 240px;
            position: fixed;
            z-index: 1;
            top: 0;
            left: 0;
            background-color: #111;
            overflow-x: hidden;
            padding-top: 16px;
        }

            .sidebar a {
                padding: 6px 8px 6px 16px;
                text-decoration: none;
                font-size: 20px;
                color: #818181;
                display: block;
            }

                .sidebar a:hover {
                    color: #2d8bff;
                }

        .main {
            margin-left: 240px; /* Same as the width of the sidenav */
            padding: 0px 10px;
        }

        @@media screen and (max-height: 450px) {
            .sidebar {
                padding-top: 15px;
            }

                .sidebar a {
                    font-size: 18px;
                }
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <a href="/Istatistik/Index/"><i class="fa fa-fw fa-home"></i> Ana Sayfa</a>
        <a href="/Kategori/Index/"><i class="fa-solid fa-bars"></i> Kategoriler</a>
        <a href="/Kitap/Index/"><i class="fa-solid fa-book"></i> Kitaplar</a>
        <a href="/Yazar/Index/"><i class="fa-solid fa-pen"></i> Yazarlar</a>
        <a href="/Uyeler/Index/"><i class="fa-regular fa-user"></i> Üyeler</a>
        <a href="/Personel/Index/"><i class="fa-regular fa-address-card"></i> Personeller</a>
        @if (User.IsInRole("S"))
        {
            <a href="/Odunc/OduncVer/"><i class="fa-regular fa-circle-right"></i> Kitap Ödünç Ver</a>
            <a href="/Odunc/Index/"><i class="fa-regular fa-circle-left"></i> Kitap Geri Al</a>
            <a href="/Islem/Index/"><i class="fa-solid fa-bolt"></i> İşlemler</a>
        }
        <a href="/Duyuru/Index/"><i class="fa-solid fa-list"></i> Duyurular</a>
        <a href="/Istatistik/Galeri/"><i class="fa-regular fa-bookmark"></i> Galeri</a>
        <a href="/Istatistik/LinqKart/"><i class="fa-regular fa-id-card"></i> Kartlar</a>
        <a href="/Vitrin/Index/"><i class="fa-regular fa-folder-open"></i> Vitrin</a>
        <a href="/Ayarlar/Admin/"><i class="fa-solid fa-gear"></i> Ayarlar</a>
        <a href="/Grafik/Index/"><i class="fa-solid fa-chart-area"></i> Grafikler</a>
        <a href="/Panel/LogOut/"><i class="fa-solid fa-right-from-bracket"></i> Çıkış</a>
    </div>

    <div class="main">
        @RenderBody()
       
    </div>

</body>
</html>
