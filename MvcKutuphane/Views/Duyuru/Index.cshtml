@using MvcKutuphane.Models.Entity
@model List<TblDuyurular>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Layout.cshtml";
}
<style>
    .table-hover tbody tr:hover td {
        background-color: #f8f9fa; /* Satırın hover rengi */
    }

    .table-hover tbody tr:hover a {
        color: #f39c12; /* Linklerin hover rengi */
    }
</style>

<h2>Duyurular</h2>
<form method="post" class="form-group">
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="thead-dark">
                <tr>
                    <th scope="col" style="background-color: #f39c12; color: #ffffff;">Duyuru No</th>
                    <th scope="col" style="background-color: #f39c12; color: #ffffff;">Kategori</th>
                    <th scope="col" style="background-color: #f39c12; color: #ffffff;">Sil</th>
                    <th scope="col" style="background-color: #f39c12; color: #ffffff;">Diğer</th>
                    <th scope="col" style="background-color: #f39c12; color: #ffffff;">Duyuru Tarihi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="background-color: @(item.id % 2 == 0 ? "#ffffff" : "#f8f9fa");">
                        <td>@item.id</td>
                        <td>@item.kategori</td>
                        <td><a href="/Duyuru/DuyuruSil/@item.id" class="btn btn-danger">Sil</a></td>
                        <td><a href="/Duyuru/DuyuruDetay/@item.id" class="btn btn-primary">Detaylar</a></td>
                        <td>@Convert.ToDateTime(item.tarih).ToString("dd/MM/yyyy")</td>

                    </tr>
                }
            </tbody>
        </table>

    </div>
    <a href="/Duyuru/YeniDuyuru/" class="btn btn-primary" style="background-color: #4100ff; color: #ffffff;">Yeni Duyuru</a>
</form>

