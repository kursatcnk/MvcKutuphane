@model MvcKutuphane.Models.Entity.TblDuyurular
@{
    ViewBag.Title = "YeniDuyuru";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<h2>Yeni Duyuru Ekleme Sayfası</h2>

<form class="form-group" method="post">
    <div>
        <label>Duyuru Başlığı</label>
        @Html.TextBoxFor(x => x.kategori, new { @class = "form-control" })
        @*@Html.ValidationMessageFor(x => x.kategori, "", new { @style = "color:red" })*@
    </div>
    <div>
        <label>Duyuru İçeriği</label>
        @Html.TextAreaFor(x => x.icerik, new { @class = "form-control" })
        @*@Html.ValidationMessageFor(x => x.kategori, "", new { @style = "color:red" })*@
    </div>
    <div>
        <label>Duyuru Tarihi</label>
        @Html.TextBoxFor(x => x.tarih, new { @class = "form-control" })
    </div>

    <div style="margin-top:15px">
        <button class="btn btn-primary" id="Btn1">Duyuru Ekle</button>
    </div>
</form>


