@using MvcKutuphane.Models.Entity
@model List<TblDuyurular>
@{
    ViewBag.Title = "Duyurular";
    Layout = "~/Views/Shared/_LayoutPanel.cshtml";
}

<style>
    .table-hover tbody tr:hover td {
        background-color: #f8f9fa; /* Satırın hover rengi */
    }

    .table-hover tbody tr:hover a {
        color: #f39c12; /* Linklerin hover rengi */
    }
</style>

<h2>Duyurular</h2>

<form method="post" class="form-group">
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead class="thead-dark">
                <tr>
                    <th scope="col" style="background-color: #f39c12; color: #ffffff;">Kategori</th>
                    <th scope="col" style="background-color: #f39c12; color: #ffffff;">Tarih</th>
                    <th scope="col" style="background-color: #f39c12; color: #ffffff;">İçerik</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    // Her iki satır için arka plan rengini manuel olarak belirleme
                    string renk = "";
                    if (item.id % 2 == 0)
                    {
                        renk = "#007bff"; // Mavi
                    }
                    else
                    {
                        renk = "#6f42c1"; // Mor
                    }

                    <tr style="background-color: @(renk);">
                        <!-- Her satır için belirlenen renk -->
                        <td>@item.kategori</td>
                        <td>@Convert.ToDateTime(@item.tarih).ToString("dd.MM.yyyy")</td>
                        <td>@item.icerik</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</form>
