@model MvcKutuphane.Models.Entity.TblKategori
@{
    ViewBag.Title = "KategoriGetir";
    Layout = "~/Views/Shared/Layout.cshtml";
}

@using (Html.BeginForm("KategoriGuncelle", "Kategori", FormMethod.Post))
{
    <div style="margin-top:15px;"></div>
    <div style="margin-bottom: 15px;"></div>
    <div class="form-group">
        @Html.HiddenFor(x => x.id)
        <label style="font-weight: bold;">#</label>
        <br />
        @Html.TextBoxFor(x => x.id, new { @class = "form-control" })
    </div>
    <br />
    <div class="form-group">
        <label style="font-weight: bold;">Kategori Adı</label>
        <br />
        @Html.TextBoxFor(x => x.ad, new { @class = "form-control" })
    </div>
    <br />
    <div>
        <button class="btn btn-success">Güncelle</button>
        <input type="hidden" name="durum" value="True" />
    </div>
}
