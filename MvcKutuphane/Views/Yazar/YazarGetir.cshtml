@model MvcKutuphane.Models.Entity.TblYazar
@{
    ViewBag.Title = "YazarGetir";
    Layout = "~/Views/Shared/Layout.cshtml";
}

@using (Html.BeginForm("YazarGuncelle", "Yazar", FormMethod.Post))
{
    <div style="margin-top:15px;"></div>
    <div style="margin-bottom: 15px;"></div>
    <div class="form-group">
        @Html.HiddenFor(x => x.id)
        <label style="font-weight: bold;">Yazar ID</label>
        <br />
        @Html.TextBoxFor(x => x.id, new { @class = "form-control" })
    </div>
    <br />
    <div class="form-group">
        <label style="font-weight: bold;">Adı</label>
        <br />
        @Html.TextBoxFor(x => x.ad, new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label style="font-weight: bold;">Soyadı</label>
        <br />
        @Html.TextBoxFor(x => x.soyad, new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label style="font-weight: bold;">Detay Bilgisi</label>
        <br />
        @Html.TextAreaFor(x => x.detay, new { @class = "form-control" })
    </div>
    <br />
    <div>
        <button class="btn btn-success">Güncelle</button>
    </div>
}
