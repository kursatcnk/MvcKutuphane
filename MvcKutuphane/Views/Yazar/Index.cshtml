@using MvcKutuphane.Models.Entity
@model  List<TblYazar>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Layout.cshtml";
}
<div style="margin-top:15px;"></div>
<h2>Yazarlar</h2>
<table class="table table-striped">
    <tr style="background-color:#ffd800">
        <th>ID</th>
        <th>Ad</th>
        <th>Soyad</th>
        <th>Detay</th>
        <th>Sil</th>
        <th>Güncelle</th>
        <th>Yazarın Kitapları</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.id</td>
            <td>@item.ad</td>
            <td>@item.soyad</td>
            <td>@item.detay</td>
            <td>@Html.ActionLink("Sil", "YazarSil", new { id = item.id }, new { @class = "btn btn-danger", onclick = "return confirm('Silmek İstediğinize Emin Misiniz')" })</td>
            <td><a href="/Yazar/YazarGetir/@item.id" class="btn btn-success">Güncelle</a></td>
            <td><a href="/Yazar/YazarKitaplar/@item.id" class="btn btn-secondary">Kitaplar</a></td>
        </tr>
    }
</table>
<a href="/Yazar/YazarEkle/" class="btn btn-primary">Yazar ekle</a>

