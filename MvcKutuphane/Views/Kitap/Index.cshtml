@using MvcKutuphane.Models.Entity
@model List<TblKitap>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Layout.cshtml";
}
<style>
    .table-hover tbody tr:hover td {
        background-color: #f8f9fa; /* Satırın hover rengi */
    }

    .table-hover tbody tr:hover a {
        color: #f39c12; /* Linklerin hover rengi */
    }

    .btn-new-book {
        background-color: #f39c12;
        color: #ffffff;
        transition: background-color 0.3s, color 0.3s, transform 0.5s ease; /* Geçiş animasyonu */
        border-radius: 10px; /* Köşeleri yuvarlama */
    }

    .btn-delete {
        background-color: #dc3545; /* Kırmızı */
        color: #ffffff;
        transition: background-color 0.3s, color 0.3s, transform 0.3s ease; /* Geçiş animasyonu */
        border-radius: 10px; /* Köşeleri yuvarlama */
    }

    .btn-update {
        background-color: #28a745; /* Yeşil */
        color: #ffffff;
        transition: background-color 0.3s, color 0.3s, transform 0.3s ease; /* Geçiş animasyonu */
        border-radius: 10px; /* Köşeleri yuvarlama */
    }

        .btn-new-book:hover, .btn-delete:hover, .btn-update:hover {
            color: #ffffff !important; /* Yazı rengi beyaz */
            font-weight: bold; /* Kalın yazı */
            background-color: #e68a00; /* Hover rengi */
            transform: scale(1.05); /* Hafif büyütme */
        }
</style>

<div style="margin-top:15px;"></div>
<h2>Kitap Sayfası</h2>

@using (Html.BeginForm("Index", "Kitap", FormMethod.Get))
{
    <div class="input-group mb-3">
        @Html.TextBox("p", null, new { @class = "form-control", placeholder = "Kitap Adı" })
        <div class="input-group-append">
            <button type="submit" class="btn btn-success">Ara</button>
        </div>
    </div>
}

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">ID</th>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Kitap Adı</th>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Kitap Yazarı</th>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Kategorisi</th>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Basım Yılı</th>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Sayfa</th>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Durum</th>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Sil</th>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Güncelle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr style="background-color: @(item.id % 2 == 0 ? "#ffffff" : "#f8f9fa");">
                    <td>@item.id</td>
                    <td>@item.ad</td>
                    <td>@item.TblYazar.ad @item.TblYazar.soyad</td>
                    <td>@item.TblKategori.ad</td>
                    <td>@item.basimtarih</td>
                    <td>@item.sayfa</td>
                    <td>@item.durum</td>
                    <td style="vertical-align: middle; text-align: center;"><a href="/Kitap/KitapSil/@item.id" class="btn btn-delete">Sil</a></td>
                    <td style="vertical-align: middle; text-align: center;"><a href="/Kitap/KitapGetir/@item.id" class="btn btn-update">Güncelle</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a href="/Kitap/KitapEkle" class="btn btn-primary btn-new-book">Yeni Kitap</a>
