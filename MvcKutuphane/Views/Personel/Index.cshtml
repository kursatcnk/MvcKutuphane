@using MvcKutuphane.Models.Entity
@model List<TblPersonel>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/Layout.cshtml";
}
<style>
    .table-hover tbody tr:hover td {
        background-color: #f8f9fa; /* Satırın hover rengi */
    }

    .table-hover tbody tr:hover a {
        color: #f39c12; /* Linklerin hover rengi */
    }
</style>

<h2>Personeller</h2>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Personel ID</th>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Kategori Adı</th>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Sil</th>
                <th scope="col" style="background-color: #f39c12; color: #ffffff;">Güncelle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr style="background-color: @(item.id % 2 == 0 ? "#ffffff" : "#f8f9fa");">
                    <td>@item.id</td>
                    <td>@item.personel</td>
                    <td><a href="/Personel/PersonelSil/@item.id" class="btn btn-danger">Sil</a></td>
                    <td><a href="/Personel/PersonelGetir/@item.id" class="btn btn-success">Güncelle</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a href="/Duyuru/YeniDuyuru/" class="btn btn-primary" style="background-color: #f39c12; color: #ffffff;">Personel Ekle</a>
