@{
    ViewBag.Title = "Galeri";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Galerimiz</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
</head>
<body>

    <div class="container">
        <h2 style="font-weight:bold">Kütüphanemizden Görüntüler</h2>
        <div id="myCarousel" class="carousel slide" data-ride="carousel" style="width:1000px; height:550px">
            <!-- Indicators -->
            <ol class="carousel-indicators">
                <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
                <li data-target="#myCarousel" data-slide-to="1"></li>
                <li data-target="#myCarousel" data-slide-to="2"></li>
                <li data-target="#myCarousel" data-slide-to="3"></li>
                <li data-target="#myCarousel" data-slide-to="4"></li>
            </ol>

            <!-- Wrapper for slides -->
            <div class="carousel-inner">
                <div class="item active">
                    <img src="~/web2/Resim/book2.jpg" alt="Chicago" style="width:100%;">
                </div>

                <div class="item">
                    <img src="~/web2/Resim/book1.jpg" alt="Chicago" style="width:100%;">
                </div>

                <div class="item">
                    <img src="~/web2/Resim/book3.jpg" alt="Chicago" style="width:100%;">
                </div>
                <div class="item">
                    <img src="~/web2/Resim/book4.jpg" alt="Chicago" style="width:100%;">
                </div>
                <div class="item">
                    <img src="~/web2/Resim/book5.jpg" alt="Chicago" style="width:100%;">
                </div>
            </div>

            <!-- Left and right controls -->
            <a class="left carousel-control" href="#myCarousel" data-slide="prev">
                <span class="glyphicon glyphicon-chevron-left"></span>
                <span class="sr-only">Geri</span>
            </a>
            <a class="right carousel-control" href="#myCarousel" data-slide="next">
                <span class="glyphicon glyphicon-chevron-right"></span>
                <span class="sr-only">İleri</span>
            </a>
        </div>

        <div style="margin-top:100px"></div>
        <form action="/Istatistik/ResimYukle" method="post" enctype="multipart/form-data">
            <input class="btn-danger" type="file" name="dosya" id="dosya" />
            <br />
            <input type="submit" value="Kaydet" class="btn btn-info" />
        </form>
    </div>



</body>
</html>
